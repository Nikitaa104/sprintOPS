# SprintOPS Cron Examples. Adjust board IDs, sprint IDs, and JQL before use.
# Commands default to dry-run. Add --apply only after reviewing output.

# Monday morning: shape next sprint scope.
0 9 * * 1 cd /home/developer/sprintops && ./automation/sprintops-shape-sprint.sh --board-id 1234 --project-key CodinzHub >> /tmp/sprintops-shape.log 2>&1

# Weekday standup: create a short progress pulse.
0 10 * * 1-5 cd /home/developer/sprintops && ./automation/sprintops-progress-pulse.sh --board-id 1234 --sprint-id 4567 >> /tmp/sprintops-pulse.log 2>&1

# Twice weekly: surface sprint delivery risk.
0 16 * * 2,4 cd /home/developer/sprintops && ./automation/sprintops-surface-risk.sh --board-id 1234 --sprint-id 4567 >> /tmp/sprintops-risk.log 2>&1
